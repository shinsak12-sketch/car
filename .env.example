# ─────────────────────────────────────────────
#  분쟁 대응 관리 프로그램 환경설정 예시
#  이 파일을 .env 로 복사한 뒤 값을 채우세요.
#  cp .env.example .env
# ─────────────────────────────────────────────

# 서버 포트
PORT=3000

# 세션 암호화 키 (아무 긴 무작위 문자열로 바꾸세요)
SESSION_SECRET=change-this-to-a-long-random-string

# 조직/현장 이름 (화면 상단에 표시)
ORG_NAME=우리 회사 대응상황실

# ─────────────────────────────────────────────
#  비상 알림(SMS/카카오) 발송 설정
#  PROVIDER 를 지정하지 않으면 실제 발송 없이
#  "기록 모드"로 동작합니다(누구에게 보낼지 기록만 남김).
#  실제 발송을 원하면 아래 중 하나를 설정하세요.
# ─────────────────────────────────────────────

# 사용할 발송 서비스: none | solapi
NOTIFY_PROVIDER=none

# 발신 번호 (사전 등록된 번호여야 함, 예: 01012345678)
NOTIFY_SENDER=

# --- Solapi (구 CoolSMS) 사용 시 ---
# https://solapi.com 가입 후 API 키 발급
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
