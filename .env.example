# ─────────────────────────────────────────────
#  분쟁 대응 관리 프로그램 (Next.js + Neon + Vercel Blob)
#  이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
#  Vercel 배포 시에는 프로젝트 → Settings → Environment Variables 에 동일하게 입력
# ─────────────────────────────────────────────

# Neon Postgres 연결 문자열 (Neon 대시보드에서 복사)
#  예: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 로그인 세션(JWT) 서명 키 — 아무 긴 무작위 문자열
#  생성 예:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 최초 DB 초기화/관리자 생성 보호용 토큰 (setup 스크립트/엔드포인트에서 사용)
SETUP_TOKEN=change-me

# 조직/현장 이름 (화면 상단 표시)
NEXT_PUBLIC_ORG_NAME=우리 회사 대응상황실

# ── Vercel Blob (증거/파일 저장) ──
#  Vercel 프로젝트 → Storage → Blob 생성 시 자동으로 주입됩니다.
#  로컬 개발 시에는 Blob 스토어의 Read/Write 토큰을 넣으세요.
BLOB_READ_WRITE_TOKEN=

# ── 비상 알림(SMS) 발송 ──
#  none 이면 실제 발송 없이 "기록 모드"로 동작합니다.
NOTIFY_PROVIDER=none
NOTIFY_SENDER=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
