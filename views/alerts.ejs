<%- include('partials/head') %>
<div class="page-head"><h1>🚨 비상 알림</h1></div>

<% if (!provider.live) { %>
<div class="flash warn">
  현재 <strong>기록 모드</strong>입니다 — 실제 문자는 발송되지 않고, <b>누구에게 무엇을 보냈는지 기록만</b> 남습니다.
  실제 문자/카톡 발송을 켜려면 <code>.env</code> 에서 <code>NOTIFY_PROVIDER</code> 와 발신번호를 설정하세요. (README 참고)
</div>
<% } else { %>
<div class="flash ok">실제 발송 켜짐 · 제공자: <%= provider.provider %> · 발신번호: <%= provider.sender %></div>
<% } %>

<form action="/alerts/send" method="post" class="form-card" onsubmit="return confirm('선택한 대상에게 비상 알림을 발송할까요?')">
  <label>알림 내용
    <textarea name="message" rows="4" required placeholder="예: [긴급] 정문 앞 집회 인원 급증. 대응조 즉시 1층 로비로 집결 바랍니다."></textarea>
  </label>

  <div class="recipients">
    <div class="recipients-head">
      <strong>수신 대상</strong>
      <span class="hint">아무도 선택하지 않으면 “비상 알림 대상”으로 지정된 연락처 전체에게 발송됩니다.</span>
    </div>

    <% if (allContacts.length === 0) { %>
      <p class="empty">전화번호가 등록된 연락처가 없습니다. <a href="/contacts">연락처</a>를 먼저 등록하세요.</p>
    <% } else { %>
      <div class="check-actions">
        <button type="button" class="mini" onclick="document.querySelectorAll('.rcpt').forEach(c=>c.checked=true)">전체 선택</button>
        <button type="button" class="mini" onclick="document.querySelectorAll('.rcpt').forEach(c=>c.checked=false)">전체 해제</button>
        <button type="button" class="mini" onclick="document.querySelectorAll('.rcpt').forEach(c=>c.checked=c.dataset.notify==='1')">알림대상만</button>
      </div>
      <div class="recipient-list">
        <% allContacts.forEach(function(c){ %>
          <label class="rcpt-item">
            <input type="checkbox" class="rcpt" name="contact_ids" value="<%= c.id %>"
                   data-notify="<%= (targets.find(t=>t.id===c.id))?'1':'0' %>"
                   <%= (targets.find(t=>t.id===c.id))?'checked':'' %> />
            <span><%= c.name %><% if (c.org){ %> <small><%= c.org %></small><% } %> · <%= c.phone %></span>
          </label>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="form-actions">
    <button class="btn-danger btn-lg">🚨 지금 발송</button>
  </div>
</form>

<h2 class="section-title">발송 이력</h2>
<% if (history.length === 0) { %>
  <p class="empty">발송 이력이 없습니다.</p>
<% } else { %>
<div class="alert-history">
  <% history.forEach(function(a){ %>
    <div class="ah-item">
      <div class="ah-top">
        <span class="ah-status ah-<%= a.status %>"><%= a.status==='sent'?'발송':(a.status==='recorded'?'기록':'실패') %></span>
        <span class="ah-time"><%= a.created_at %></span>
        <span class="ah-by"><%= a.sender_name || '-' %></span>
        <span class="ah-count"><%= a.success_cnt %>/<%= a.recipient_cnt %>명</span>
      </div>
      <div class="ah-msg"><%= a.message %></div>
      <% if (a.recipientsParsed && a.recipientsParsed.length) { %>
        <details class="ah-detail">
          <summary>수신자 <%= a.recipientsParsed.length %>명</summary>
          <div class="ah-rcpts">
            <% a.recipientsParsed.forEach(function(r){ %>
              <span class="ah-rcpt <%= r.ok?'ok':'ng' %>"><%= r.name %> <%= r.ok?'✓':'✕' %></span>
            <% }) %>
          </div>
        </details>
      <% } %>
    </div>
  <% }) %>
</div>
<% } %>
<%- include('partials/foot') %>
