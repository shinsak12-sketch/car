<%- include('partials/head') %>
<% function catClass(c){ return 'cat cat-'+({['집회']:'assembly','소음':'noise','충돌':'clash','접촉':'contact','경찰':'police'}[c]||'etc'); } %>

<div class="page-head">
  <h1>대응 상황판</h1>
  <a href="/alerts" class="btn-danger">🚨 비상 알림 보내기</a>
</div>

<div class="stat-grid">
  <a class="stat" href="/timeline"><span class="stat-num"><%= stats.timeline %></span><span class="stat-label">상황 일지</span></a>
  <a class="stat" href="/tasks"><span class="stat-num"><%= stats.tasksOpen %></span><span class="stat-label">진행중 업무</span></a>
  <a class="stat" href="/tasks"><span class="stat-num"><%= stats.tasksDone %></span><span class="stat-label">완료 업무</span></a>
  <a class="stat" href="/contacts"><span class="stat-num"><%= stats.contacts %></span><span class="stat-label">연락처</span></a>
  <a class="stat" href="/files"><span class="stat-num"><%= stats.files %></span><span class="stat-label">자료</span></a>
  <a class="stat" href="/alerts"><span class="stat-num"><%= stats.notifyTargets %></span><span class="stat-label">알림 대상</span></a>
</div>

<% if (lastAlert) { %>
<div class="last-alert">
  <strong>최근 비상 알림</strong> ·
  <%= lastAlert.created_at %> · <%= lastAlert.sender_name || '-' %> ·
  수신 <%= lastAlert.success_cnt %>/<%= lastAlert.recipient_cnt %>명
  <div class="last-alert-msg"><%= lastAlert.message %></div>
</div>
<% } %>

<div class="dash-cols">
  <section class="card">
    <div class="card-head">
      <h2>최근 상황 일지</h2>
      <a href="/timeline/new" class="btn-sm">＋ 기록</a>
    </div>
    <% if (recentTimeline.length === 0) { %>
      <p class="empty">아직 기록이 없습니다. 상황이 생기면 바로 남겨두세요.</p>
    <% } else { %>
      <ul class="tl-list">
        <% recentTimeline.forEach(function(t){ %>
          <li>
            <a href="/timeline/<%= t.id %>">
              <span class="<%= catClass(t.category) %>"><%= t.category %></span>
              <span class="tl-title"><%= t.title %></span>
            </a>
            <div class="tl-meta"><%= t.occurred_at.replace('T',' ') %> · <%= t.author_name || '-' %><% if (t.file_count>0){ %> · 📎<%= t.file_count %><% } %></div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>처리할 업무</h2>
      <a href="/tasks" class="btn-sm">전체 보기</a>
    </div>
    <% if (openTasks.length === 0) { %>
      <p class="empty">진행중인 업무가 없습니다.</p>
    <% } else { %>
      <ul class="task-mini">
        <% openTasks.forEach(function(t){ %>
          <li>
            <span class="pri pri-<%= t.priority %>"></span>
            <span class="task-mini-title"><%= t.title %></span>
            <span class="task-mini-meta">
              <% if (t.assignee_name){ %><%= t.assignee_name %><% } %>
              <% if (t.due_date){ %> · ~<%= t.due_date %><% } %>
              <span class="chip chip-<%= t.status %>"><%= t.status === 'doing' ? '진행중' : '할일' %></span>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
<%- include('partials/foot') %>
