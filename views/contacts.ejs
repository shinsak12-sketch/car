<%- include('partials/head') %>
<% function catBadge(c){ return 'ct ct-'+({['경찰']:'police','구청':'gov','변호사':'law','사내':'internal','상대측':'opp'}[c]||'etc'); } %>

<div class="page-head">
  <h1>연락처 · 관계자</h1>
  <button class="btn-primary" onclick="document.getElementById('contactForm').classList.toggle('show')">＋ 연락처 추가</button>
</div>

<form id="contactForm" action="/contacts" method="post" class="form-card collapsible">
  <div class="grid2">
    <label>이름 <input type="text" name="name" required /></label>
    <label>분류
      <select name="category">
        <% categories.forEach(function(c){ %><option value="<%= c %>"><%= c %></option><% }) %>
      </select>
    </label>
    <label>소속/기관 <input type="text" name="org" placeholder="예: OO경찰서 정보과" /></label>
    <label>직책/역할 <input type="text" name="role" placeholder="예: 담당 경관" /></label>
    <label>전화번호 <input type="tel" name="phone" placeholder="010-0000-0000" /></label>
    <label>이메일 <input type="email" name="email" /></label>
  </div>
  <label>메모 <textarea name="memo" rows="2"></textarea></label>
  <label class="check"><input type="checkbox" name="notify" value="1" /> 비상 알림 대상에 포함</label>
  <div class="form-actions"><button class="btn-primary">추가</button></div>
</form>

<form class="filterbar" method="get" action="/contacts">
  <div class="chips">
    <a href="/contacts" class="chip-f <%= !category ? 'on':'' %>">전체</a>
    <% categories.forEach(function(c){ %>
      <a href="/contacts?category=<%= encodeURIComponent(c) %>" class="chip-f <%= category===c?'on':'' %>"><%= c %></a>
    <% }) %>
  </div>
  <input type="search" name="q" value="<%= q %>" placeholder="이름·기관·번호 검색" />
  <button class="btn-sm">검색</button>
</form>

<% if (items.length === 0) { %>
  <p class="empty big">등록된 연락처가 없습니다.</p>
<% } else { %>
<div class="contact-grid">
  <% items.forEach(function(c){ %>
    <div class="contact-card">
      <div class="contact-top">
        <span class="<%= catBadge(c.category) %>"><%= c.category %></span>
        <% if (c.notify) { %><span class="notify-dot" title="비상 알림 대상">🚨</span><% } %>
      </div>
      <div class="contact-name"><%= c.name %><% if (c.role){ %> <small><%= c.role %></small><% } %></div>
      <% if (c.org){ %><div class="contact-org"><%= c.org %></div><% } %>
      <% if (c.phone){ %><a href="tel:<%= c.phone %>" class="contact-phone">📞 <%= c.phone %></a><% } %>
      <% if (c.email){ %><div class="contact-email">✉ <%= c.email %></div><% } %>
      <% if (c.memo){ %><div class="contact-memo"><%= c.memo %></div><% } %>
      <div class="contact-actions">
        <button class="mini" onclick="toggleEdit('edit-<%= c.id %>')">수정</button>
        <form action="/contacts/<%= c.id %>/delete" method="post" class="inline" onsubmit="return confirm('삭제할까요?')">
          <button class="mini del">삭제</button>
        </form>
      </div>

      <form id="edit-<%= c.id %>" action="/contacts/<%= c.id %>" method="post" class="edit-form" style="display:none">
        <input type="text" name="name" value="<%= c.name %>" placeholder="이름" required />
        <select name="category">
          <% categories.forEach(function(cc){ %><option value="<%= cc %>" <%= c.category===cc?'selected':'' %>><%= cc %></option><% }) %>
        </select>
        <input type="text" name="org" value="<%= c.org || '' %>" placeholder="소속" />
        <input type="text" name="role" value="<%= c.role || '' %>" placeholder="직책" />
        <input type="tel" name="phone" value="<%= c.phone || '' %>" placeholder="전화" />
        <input type="email" name="email" value="<%= c.email || '' %>" placeholder="이메일" />
        <textarea name="memo" rows="2" placeholder="메모"><%= c.memo || '' %></textarea>
        <label class="check"><input type="checkbox" name="notify" value="1" <%= c.notify?'checked':'' %> /> 비상 알림 대상</label>
        <button class="btn-sm">저장</button>
      </form>
    </div>
  <% }) %>
</div>
<% } %>
<%- include('partials/foot') %>
