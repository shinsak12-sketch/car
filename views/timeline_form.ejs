<%- include('partials/head') %>
<%
  var isEdit = !!item;
  var action = isEdit ? '/timeline/' + item.id : '/timeline';
  var now = new Date();
  var localNow = new Date(now.getTime() - now.getTimezoneOffset()*60000).toISOString().slice(0,16);
  var occ = item ? (item.occurred_at || '').slice(0,16) : localNow;
%>
<div class="page-head"><h1><%= isEdit ? '일지 수정' : '새 상황 기록' %></h1></div>

<form action="<%= action %>" method="post" enctype="multipart/form-data" class="form-card">
  <label>발생 시각
    <input type="datetime-local" name="occurred_at" value="<%= occ %>" required />
  </label>

  <label>분류
    <select name="category">
      <% categories.forEach(function(c){ %>
        <option value="<%= c %>" <%= (item && item.category===c) ? 'selected':'' %>><%= c %></option>
      <% }) %>
    </select>
  </label>

  <label>제목
    <input type="text" name="title" value="<%= item ? item.title : '' %>" placeholder="예: 확성기 소음 발생 / 정문 앞 인원 집결" required />
  </label>

  <label>내용
    <textarea name="body" rows="7" placeholder="누가, 무엇을, 어떻게. 대응 내용과 현장 상황을 상세히 남기세요."><%= item ? item.body : '' %></textarea>
  </label>

  <label>사진 · 파일 첨부 (여러 개 가능)
    <input type="file" name="photos" multiple accept="image/*,video/*,.pdf,.doc,.docx,.hwp" />
  </label>

  <div class="form-actions">
    <button type="submit" class="btn-primary">저장</button>
    <a href="<%= isEdit ? '/timeline/'+item.id : '/timeline' %>" class="btn-ghost">취소</a>
  </div>
</form>
<%- include('partials/foot') %>
