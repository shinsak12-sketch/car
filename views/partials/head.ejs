<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1f2937" />
  <title><%= title ? title + ' · ' : '' %><%= orgName %></title>
  <link rel="stylesheet" href="/static/css/style.css" />
</head>
<body>
<% if (currentUser) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a href="/" class="brand">🛡️ <span><%= orgName %></span></a>
    <button class="nav-toggle" onclick="document.body.classList.toggle('nav-open')" aria-label="메뉴">☰</button>
    <nav class="mainnav">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">상황판</a>
      <a href="/timeline" class="<%= path.startsWith('/timeline') ? 'active' : '' %>">상황 일지</a>
      <a href="/tasks" class="<%= path.startsWith('/tasks') ? 'active' : '' %>">대응 업무</a>
      <a href="/contacts" class="<%= path.startsWith('/contacts') ? 'active' : '' %>">연락처</a>
      <a href="/files" class="<%= path.startsWith('/files') ? 'active' : '' %>">자료함</a>
      <a href="/alerts" class="alert-link <%= path.startsWith('/alerts') ? 'active' : '' %>">🚨 비상 알림</a>
      <% if (currentUser.role === 'admin') { %>
        <a href="/users" class="<%= path.startsWith('/users') ? 'active' : '' %>">사용자</a>
      <% } %>
    </nav>
    <div class="topbar-right">
      <a href="/account" class="whoami"><%= currentUser.name %><% if (currentUser.role === 'admin') { %> <span class="badge-admin">관리자</span><% } %></a>
      <form action="/logout" method="post" class="inline"><button class="btn-ghost">로그아웃</button></form>
    </div>
  </div>
</header>
<% } %>
<main class="container">
