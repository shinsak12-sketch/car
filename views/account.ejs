<%- include('partials/head') %>
<div class="page-head"><h1>내 계정</h1></div>
<% if (msg) { %><div class="flash ok"><%= msg %></div><% } %>
<% if (error) { %><div class="flash error"><%= error %></div><% } %>

<div class="form-card">
  <div class="account-info">
    <div><span>아이디</span><b><%= currentUser.username %></b></div>
    <div><span>이름</span><b><%= currentUser.name %></b></div>
    <div><span>권한</span><b><%= currentUser.role === 'admin' ? '관리자' : '일반' %></b></div>
  </div>
</div>

<h2 class="section-title">비밀번호 변경</h2>
<form action="/account/password" method="post" class="form-card">
  <label>현재 비밀번호 <input type="password" name="current" required /></label>
  <label>새 비밀번호 <input type="password" name="next1" required /></label>
  <label>새 비밀번호 확인 <input type="password" name="next2" required /></label>
  <div class="form-actions"><button class="btn-primary">변경</button></div>
</form>
<%- include('partials/foot') %>
